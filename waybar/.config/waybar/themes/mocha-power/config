// ----------------------------------------------------- 
// Mocha-Power theme based on Jan-Aarela's dotfiles
// Adapted for hypr_simplified (based on ml4w-modern)
// ----------------------------------------------------- 

[
    {
        // MAIN BAR //
        "layer": "top",
        "position": "top",
        "name": "main",
        "height": 28,
        "reload_style_on_change": true,

        "margin-top": 24,
        "margin-left": 24,
        "margin-right": 24,
        "spacing": 0,

        // Load Modules
        "include": [
            "~/.config/waybar/modules.json"
        ],

        "modules-left": [
            "group/traym",
            "hyprland/workspaces",
            "hyprland/submap",
            "hyprland/window"
        ],

        "modules-right": [
            "custom/spacer1",
            "group/perf",
            "custom/spacer2",
            "custom/dictation",
            "group/audio",
            "custom/spacer3",
            "group/power",
            "custom/spacer4",
            "custom/weather",
            "custom/spacer-bg2",
            "custom/calendar",
            "custom/spacer-bg2",
            "group/datetime"
        ],

        "group/traym": {
            "orientation": "horizontal",
            "drawer": {},
            "modules": ["custom/trayicon", "tray"]
        },

        // Hover drawers: the first module is always shown, the rest slide
        // out to its left on hover.
        "group/perf": {
            "orientation": "horizontal",
            "drawer": { "transition-duration": 300, "transition-left-to-right": false },
            "modules": [
                "custom/sysusage",
                "custom/updates",
                "custom/spacer-bg1",
                "temperature",
                "custom/spacer-bg1",
                "custom/bandwidth",
                "custom/spacer-bg1"
            ]
        },

        "group/audio": {
            "orientation": "horizontal",
            "drawer": { "transition-duration": 300, "transition-left-to-right": false },
            "modules": [
                "pulseaudio",
                "bluetooth",
                "custom/spacer-bg2"
            ]
        },

        "group/power": {
            "orientation": "horizontal",
            "drawer": { "transition-duration": 300, "transition-left-to-right": false },
            "modules": [
                "battery",
                "hyprland/language",
                "custom/spacer-bg1",
                "backlight",
                "custom/spacer-bg1"
            ]
        },

        "group/datetime": {
            "orientation": "horizontal",
            "drawer": { "transition-duration": 300, "transition-left-to-right": false },
            "modules": [
                "clock",
                "clock#date",
                "custom/spacer-bg2"
            ]
        },

        "clock": {
            "format": "{:%H:%M:%S}",
            "tooltip-format": "{:%A\n%Y-%m-%d}",
            "timezone": "Europe/London",
            "interval": 1
        },

        "clock#date": {
            "format": "{:%Y-%m-%d}",
            "tooltip": false,
            "timezone": "Europe/London",
            "interval": 60
        },

        "backlight": {
            "device": "intel_backlight",
            "format": "{icon} {percent}%",
            "format-icons": ["󱩎", "󱩑", "󱩓", "󱩕", "󰛨"],
            "scroll-step": 1,
            "on-scroll-up": "brightnessctl set 2%-",
            "on-scroll-down": "brightnessctl set +2%"
        },

        "hyprland/submap": {
            "always-on": true,
            "default-submap": "",
            "format": "{}",
            "format-RESIZE": "{}lol",
            "tooltip": false
        },

        "custom/spacer1": {
            "format": "",
            "tooltip": false
        },

        "custom/spacer2": {
            "format": "",
            "tooltip": false
        },

        "custom/spacer3": {
            "format": "",
            "tooltip": false
        },

        "custom/spacer4": {
            "format": "",
            "tooltip": false
        },

        "custom/spacer-bg1": {
            "format": "",
            "tooltip": false
        },

        "custom/spacer-bg2": {
            "format": "",
            "tooltip": false
        },

        "custom/trayicon": {
            "format": "ᗧ ",
            "tooltip": false
        }
    },

    {
        // INDICATOR BAR //
        "layer": "top",
        "position": "top",
        "name": "indicator",
        "passthrough": true,
        "reload_style_on_change": true,

        "height": 30,

        "margin-top": -29,
        "margin-right": 24,

        "modules-right": ["custom/batteryindicator"],

        "custom/batteryindicator": {
            "interval": 4,
            "return-type": "json",
            "tooltip": false,
            "format": " ",
            "exec": "~/.config/hypr/themes/Mocha-Power/bat-pp.sh bar"
        }
    }
]
